# =============================================================================
# CI Dockerfile — SELF-CONTAINED standalone-repo frontend build (PLAT-1009).
# @shizuha/ui is resolved from the in-cluster npm-cache (Verdaccio), not file:.
# Build context = the service repo ROOT.
# =============================================================================
FROM node:20-alpine AS builder
WORKDIR /build
ARG NPM_CONFIG_REGISTRY=http://npm-cache.registry.svc.cluster.local:4873/
ENV NPM_CONFIG_REGISTRY=$NPM_CONFIG_REGISTRY
COPY frontend/package*.json ./
COPY frontend/vendor/ ./vendor/
# Patch monorepo file: reference to a published npm package resolved via npm-cache.
RUN sed -i 's|"@shizuha/ui": "file:[^"]*"|"@shizuha/ui": "^1.2.6"|g' package.json
RUN npm ci --no-audit --no-fund
COPY frontend/ .
ARG VITE_BASE_PATH=/mail/
ARG VITE_API_BASE=/mail/api
ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_HMR_DISABLE=true
ENV NODE_ENV=production
RUN npm run build
FROM nginx:alpine
RUN apk add --no-cache 'expat>=2.8.5-r0'
COPY --from=builder /build/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/health || exit 1
CMD ["nginx", "-g", "daemon off;"]
